<% if (is_home()) { %><section class="hero"><p class="eyebrow">BIG BEN’S NOTEBOOK</p><h1>保持好奇，<br>每天进步一点点<span class="accent">。</span></h1><p class="intro">在这里，记录学习的足迹，收藏阅读的感悟，<br class="desktop">也留住生活中值得记下的片刻。</p><a class="text-link" href="<%- url_for('/about/') %>">关于我 <span aria-hidden="true">↗</span></a></section><% } %>
<section aria-labelledby="posts-heading"><div class="section-heading"><h2 id="posts-heading"><%= is_home() ? '最近的文字' : page.category ? '分类 · ' + page.category : page.tag ? '标签 · ' + page.tag : '文章归档' %></h2><span><%= is_home() ? site.posts.length + ' 篇记录' : '学习与生活的足迹' %></span></div>
<% page.posts.each(post => { %><article class="post-card"><div class="post-meta"><time datetime="<%= date_xml(post.date) %>"><%= date(post.date, 'YYYY.MM.DD') %></time><% post.categories.each(c => { %><a href="<%- url_for(c.path) %>"><%= c.name %></a><% }) %></div><h2><a href="<%- url_for(post.path) %>"><%= post.title %></a></h2><p class="excerpt"><%= truncate(strip_html(post.description || post.excerpt || post.content), {length: 135}) %></p><a class="text-link" href="<%- url_for(post.path) %>">阅读全文 <span aria-hidden="true">→</span></a></article><% }) %>
<% if (page.total > 1) { %><nav class="pagination" aria-label="分页"><%- paginator({prev_text: '上一页', next_text: '下一页'}) %></nav><% } %></section>
