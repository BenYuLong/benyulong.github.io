<article class="article"><header class="article-header"><p class="eyebrow">随笔与记录</p><h1><%= page.title %></h1><div class="post-meta"><time datetime="<%= date_xml(page.date) %>"><%= date(page.date, 'YYYY年MM月DD日') %></time><% page.categories.each(c => { %><a href="<%- url_for(c.path) %>"><%= c.name %></a><% }) %></div></header><div class="prose"><%- page.content %></div><footer class="article-tags"><% page.tags.each(t => { %><a href="<%- url_for(t.path) %>"># <%= t.name %></a><% }) %></footer><nav class="post-navigation" aria-label="相邻文章"><% if (page.prev) { %><a href="<%- url_for(page.prev.path) %>">← <%= page.prev.title %></a><% } %><% if (page.next) { %><a href="<%- url_for(page.next.path) %>"><%= page.next.title %> →</a><% } %></nav></article>
